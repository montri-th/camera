{
  "name": "citymeter-camera-shops",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "description": "CityMETER · Camera Shops — neighborhood-first 3D map of camera-shop outlets in Thailand (same 0.5 architecture as CityMETER · Luxury Brands)",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "test": "node --test tests/*.test.js",
    "start": "python3 -m http.server 4173 --bind 127.0.0.1",
    "handoff:manifest": "node scripts/build-handoff.mjs",
    "handoff:bundle": "node scripts/build-handoff.mjs --zip dist/CityMETER-Camera-Shops-Developer-Handoff.zip",
    "verify:live": "node scripts/verify-live.mjs",
    "data:build": "python3 scripts/build-camera-data.py",
    "data:provinces": "node scripts/extract-provinces.mjs",
    "assets:manifest": "python3 scripts/build-asset-manifest.py"
  }
}
